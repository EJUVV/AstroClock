# Valores do projeto horas-dev no Supabase (peça ao Victor)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Painel de teste do protótipo (troca de perfil e de estado). Sempre aparece no npm run dev.
# Num site publicado, só aparece com true. Nunca ligue em produção.
VITE_MOSTRAR_DEMO=

# Login de demonstração, sem Google: com true, o perfil é escolhido no botão de frasco.
# Vazio = login real com Google. Só para o site de protótipo. Nunca ligue em produção.
VITE_LOGIN_FALSO=
